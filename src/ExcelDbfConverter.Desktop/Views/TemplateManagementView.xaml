<UserControl x:Class="ExcelDbfConverter.Desktop.Views.TemplateManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="950">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="模板管理" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="导入" Style="{StaticResource SecondaryButton}" Command="{Binding ImportCommand}"/>
                    <Button Content="导出" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}" Margin="8,0,0,0"/>
                    <Button Content="新建" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                      AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource CardBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="模板名称" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="字段数" Binding="{Binding Fields.Count}" Width="80"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime, StringFormat=yyyy-MM-dd}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="6" Padding="16" Width="320" Margin="12,0,0,0">
            <StackPanel>
                <TextBlock Text="模板信息" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock Text="名称" Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <TextBlock Text="描述" Margin="0,0,0,4"/>
                <TextBox Text="{Binding EditorDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="90"/>
                    <Button Content="删除" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteCommand}" MinWidth="90" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="提示：模板保存的是字段配置（Excel 列名、DBF 字段名、类型、长度、小数位），可在 Excel → DBF 页面选择应用。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
