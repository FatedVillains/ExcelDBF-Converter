    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ExcelDbfConverter.Desktop</RootNamespace>
    <AssemblyName>ExcelDBFConverter</AssemblyName>
    <ApplicationIcon />
    <Version>1.0.0</Version>
